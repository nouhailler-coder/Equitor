{
  "name": "equiprogression",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts && npm run check:legal",
    "check:legal": "tsx scripts/check-legal.ts",
    "icons": "node scripts/generate-icons.mjs",
    "clean": "rm -rf dist",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "landing:dev": "vite --config landing/vite.config.mjs",
    "landing:build": "vite build --config landing/vite.config.mjs",
    "landing:preview": "vite preview --config landing/vite.config.mjs",
    "landing:assets": "node scripts/landing-assets.mjs",
    "landing:screens": "node scripts/landing-screenshots.mjs",
    "landing:test": "npm run landing:build && tsx --test landing/tests/*.test.ts && node scripts/landing-e2e.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dexie": "^4.4.7",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
